<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!doctype html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}" /> | MVC E-Ticaret</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css">
</head>
<body>
<header class="site-header">
    <nav class="nav-bar">
        <a class="brand" href="${pageContext.request.contextPath}/">MVC Market</a>
        <form class="nav-search" action="${pageContext.request.contextPath}/products" method="get">
            <input type="search" name="q" value="<c:out value='${search}' />" placeholder="Ürün ara">
            <button type="submit">Ara</button>
        </form>
        <div class="nav-links">
            <a href="${pageContext.request.contextPath}/cart">
                Sepet
                <c:if test="${sessionScope.cart.totalQuantity > 0}">
                    <span class="pill"><c:out value="${sessionScope.cart.totalQuantity}" /></span>
                </c:if>
            </a>
            <c:choose>
                <c:when test="${not empty sessionScope.currentUser}">
                    <a href="${pageContext.request.contextPath}/my-orders">Siparişlerim</a>
                    <c:if test="${sessionScope.currentUser.admin}">
                        <a href="${pageContext.request.contextPath}/admin/dashboard">Admin</a>
                    </c:if>
                    <form action="${pageContext.request.contextPath}/logout" method="post" class="inline-form">
                        <button type="submit" class="link-button">Çıkış</button>
                    </form>
                </c:when>
                <c:otherwise>
                    <a href="${pageContext.request.contextPath}/login">Giriş</a>
                    <a class="button small" href="${pageContext.request.contextPath}/register">Kayıt</a>
                </c:otherwise>
            </c:choose>
        </div>
    </nav>
</header>
<main class="page">
    <c:if test="${not empty flashSuccess}">
        <div class="alert success"><c:out value="${flashSuccess}" /></div>
    </c:if>
    <c:if test="${not empty flashError}">
        <div class="alert error"><c:out value="${flashError}" /></div>
    </c:if>
