<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!doctype html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}" /> | Admin</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css">
</head>
<body class="admin-body">
<aside class="admin-sidebar">
    <a class="brand" href="${pageContext.request.contextPath}/admin/dashboard">MVC Admin</a>
    <nav>
        <a href="${pageContext.request.contextPath}/admin/dashboard">Panel</a>
        <a href="${pageContext.request.contextPath}/admin/categories">Kategoriler</a>
        <a href="${pageContext.request.contextPath}/admin/products">Ürünler</a>
        <a href="${pageContext.request.contextPath}/admin/orders">Siparişler</a>
        <a href="${pageContext.request.contextPath}/admin/users">Kullanıcılar</a>
        <a href="${pageContext.request.contextPath}/">Mağaza</a>
    </nav>
    <form action="${pageContext.request.contextPath}/admin/logout" method="post">
        <button type="submit" class="button ghost full">Çıkış</button>
    </form>
</aside>
<main class="admin-main">
    <c:if test="${not empty flashSuccess}">
        <div class="alert success"><c:out value="${flashSuccess}" /></div>
    </c:if>
    <c:if test="${not empty flashError}">
        <div class="alert error"><c:out value="${flashError}" /></div>
    </c:if>
